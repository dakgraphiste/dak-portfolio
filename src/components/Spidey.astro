---
// Let'z Go, la mascotte 3D de Dak, suspendue à son fil façon Spider-Man.
// Le fil s'étire quand on défile, la mascotte se balance avec la souris et le défilement.
---
<div class="spidey" data-spidey>
  <div class="spidey-rig">
    <span class="web" aria-hidden="true"></span>
    <button type="button" class="spidey-btn" aria-label="Let'z Go ! Dire bonjour à Dak" aria-expanded="false">
      <img src="/images/mascotte.webp" alt="" width="382" height="1241" />
    </button>
    <span class="bubble" role="status">
      <b>Let'z Go !</b> On crée quelque chose ensemble ?
      <a href="/contact">Écris-moi →</a>
    </span>
  </div>
</div>

<style is:global>
  .spidey { position: fixed; top: 0; right: clamp(10px, 2.4vw, 40px); z-index: 40; pointer-events: none; }
  .spidey-rig { display: flex; flex-direction: column; align-items: center; transform-origin: 50% 0; will-change: transform; }
  .spidey .web { display: block; width: 2px; height: var(--len, 0px); background: linear-gradient(90deg, rgba(0,0,0,.28), rgba(255,255,255,.95), rgba(0,0,0,.28)); box-shadow: 0 0 6px rgba(255,255,255,.35); }
  .spidey-btn { pointer-events: auto; border: 0; background: none; padding: 0; margin-top: -4px; cursor: pointer; }
  .spidey-btn img { display: block; height: clamp(120px, 22vh, 210px); width: auto; transform: rotate(180deg); filter: drop-shadow(0 16px 18px rgba(0,0,0,.28)); transition: transform .45s cubic-bezier(.2,.9,.25,1.3); }
  .spidey-btn:hover img { transform: rotate(180deg) scale(1.07); }
  .spidey-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: 12px; }
  .spidey .bubble { position: absolute; right: calc(100% - 6px); bottom: 34%; width: 220px; padding: 14px 16px; border-radius: 18px 18px 4px 18px; background: #FFFFFF; color: #141010; font-size: 14px; line-height: 1.45; box-shadow: 0 18px 40px -16px rgba(0,0,0,.45); opacity: 0; transform: translateX(10px) scale(.9); transform-origin: 100% 100%; transition: opacity .3s, transform .45s cubic-bezier(.2,.9,.25,1.3); pointer-events: none; }
  .spidey .bubble b { color: var(--accent-text); }
  .spidey .bubble a { display: inline-block; margin-top: 6px; font-weight: 700; color: #0A0A0A; text-decoration: underline; text-underline-offset: 3px; }
  .spidey.talk .bubble, .spidey-btn:hover + .bubble { opacity: 1; transform: none; }
  .spidey.talk .bubble { pointer-events: auto; }
  .menu-open .spidey { display: none; }
  @media (max-width: 700px) { .spidey { right: 6px; } .spidey-btn img { height: 96px; } .spidey .bubble { width: 180px; font-size: 13px; } }
</style>
