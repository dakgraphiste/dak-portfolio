---
import type { Project } from '../data/site';
interface Props { project: Project; }
const { project } = Astro.props;
---
<a href={`/projets/${project.slug}`} class="pcard" data-cat={project.category} data-cursor="Voir">
  {project.gallery.slice(0, 3).map((g) => <span class="casc" aria-hidden="true"><img src={g} alt="" loading="lazy" /></span>)}
  <div class="vis">
    <img src={project.cover} alt={project.title} loading="lazy" />
    <span class="pill">Voir le projet →</span>
  </div>
  <div class="meta"><b>{project.title}</b><span class="muted">{project.categoryLabel}</span></div>
</a>
