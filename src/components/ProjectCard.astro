---
import { sm, srcset, isAgency, type Project } from '../data/site';
interface Props { project: Project; }
const { project } = Astro.props;
---
<a href={`/projets/${project.slug}`} class="pcard" data-cat={project.category} data-cursor="Voir">
  {project.gallery.slice(0, 3).map((g) => <span class={project.gallery.length > 1 ? 'casc real' : 'casc'} aria-hidden="true"><img src={sm(g)} alt="" loading="lazy" /></span>)}
  <div class="vis">
    <img src={project.cover} srcset={srcset(project.cover)} sizes="(max-width: 860px) 100vw, 420px" alt="" loading="lazy" />
    <span class="pill">Voir le projet →</span>
    {isAgency(project) && <span class="agency">En agence</span>}
  </div>
  <div class="meta"><b>{project.title}</b><span class="muted">{project.categoryLabel}</span></div>
</a>
