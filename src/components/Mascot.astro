---
// Let'z Go, la mascotte 3D de Dak, debout dans les sections d'appel à l'action.
interface Props { pose?: 1 | 2 | 3 | 4; bubble?: string; class?: string }
const { pose = 1, bubble, class: cls = '' } = Astro.props;
const SRC = { 1: '/images/mascotte.webp', 2: '/images/mascotte-2.webp', 3: '/images/mascotte-3.webp', 4: '/images/mascotte-4.webp' };
---
<div class={`masc ${cls}`} aria-hidden="true">
  {bubble && <span class="masc-bubble">{bubble}</span>}
  <img src={SRC[pose]} alt="" loading="lazy" decoding="async" />
</div>

<style is:global>
  .masc { position: absolute; bottom: 0; z-index: 2; pointer-events: none; }
  .masc img { display: block; height: clamp(240px, 26vw, 380px); width: auto; transform-origin: 50% 100%; animation: masc-bob 3.4s ease-in-out infinite; filter: drop-shadow(0 18px 22px rgba(0,0,0,.35)); }
  @keyframes masc-bob { 50% { transform: translateY(-8px) rotate(-1.5deg); } }
  .masc-bubble { position: absolute; bottom: 86%; left: 88%; white-space: nowrap; padding: 10px 16px; border-radius: 18px 18px 18px 4px; background: #FFFFFF; color: #141010; font: 700 15px var(--font-body); box-shadow: 0 14px 30px -12px rgba(0,0,0,.45); animation: masc-pop 3.4s ease-in-out infinite; }
  @keyframes masc-pop { 0%, 100% { transform: translateY(0) scale(1); } 50% { transform: translateY(-6px) scale(1.04); } }
  .cta-band { position: relative; }
  .cta-band .masc { left: 50%; }
  @media (max-width: 860px) { .cta-band .masc { left: auto; right: 12px; } .cta-band .masc img { height: 200px; } .cta-band .masc-bubble { display: none; } }
  @media (prefers-reduced-motion: reduce) { .masc img, .masc-bubble { animation: none; } }
</style>
