---
// Niveau affiché en 3 barres (1 = débutant, 2 = intermédiaire, 3 = avancé)
import { LEVEL_DOTS, type Level } from '../../data/academy';
interface Props { level: Level; light?: boolean }
const { level, light = false } = Astro.props;
const n = LEVEL_DOTS[level];
---
<span class:list={['lvlbar', { light }]} title={`Niveau ${level.toLowerCase()}`}>
  <span class="bars" aria-hidden="true">{[1, 2, 3].map((i) => <i class:list={{ on: i <= n }}></i>)}</span>{level}
</span>
