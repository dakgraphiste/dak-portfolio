---
// Scène logo : grille de construction qui se trace, logo vectorisé dessiné puis rempli, symbole.
interface Props { brand: { logo: string; symbol?: string }; name: string }
const { brand, name } = Astro.props;
const svgs = import.meta.glob('../../brand/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const get = (n?: string) => (n ? svgs[`../../brand/${n}.svg`] : undefined);
const bgOf = (svg?: string) => (svg ? (svg.match(/data-bg="([^"]+)"/) || [])[1] || '#111' : '#111');
const ink = (hex: string) => { const n = parseInt(hex.slice(1), 16), l = (0.299 * (n >> 16) + 0.587 * ((n >> 8) & 255) + 0.114 * (n & 255)) / 255; return l > 0.6 ? '#141010' : '#FFFFFF'; };
const logo = get(brand.logo), sym = get(brand.symbol);
const lbg = bgOf(logo), sbg = bgOf(sym);
---
<section class="cs-logo" style={`--lbg:${lbg};--link:${ink(lbg)}`} data-logo-stage>
  <div class="wrap cs-logo-head">
    <span class="cs-kicker">Le logo</span>
    <button type="button" class="cs-replay" data-replay aria-label="Rejouer l'animation du logo">Rejouer ↺</button>
  </div>
  <div class="cs-logo-canvas">
    <svg class="cs-grid" viewBox="0 0 1000 560" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
      <g fill="none" stroke="currentColor" stroke-width="1">
        <path class="gl" pathLength="1" d="M0 280H1000" /><path class="gl" pathLength="1" d="M500 0V560" />
        <path class="gl" pathLength="1" d="M0 140H1000" /><path class="gl" pathLength="1" d="M0 420H1000" />
        <path class="gl" pathLength="1" d="M250 0V560" /><path class="gl" pathLength="1" d="M750 0V560" />
        <path class="gl" pathLength="1" d="M220 0L780 560" /><path class="gl" pathLength="1" d="M780 0L220 560" />
        <circle class="gl gc" pathLength="1" cx="500" cy="280" r="130" /><circle class="gl gc" pathLength="1" cx="500" cy="280" r="230" />
        <rect class="gl" pathLength="1" x="270" y="150" width="460" height="260" rx="2" />
      </g>
      <g class="gl-dots" fill="currentColor">
        <circle cx="500" cy="280" r="4" /><circle cx="270" cy="150" r="3" /><circle cx="730" cy="150" r="3" /><circle cx="270" cy="410" r="3" /><circle cx="730" cy="410" r="3" />
      </g>
    </svg>
    <div class="cs-logo-svg" set:html={logo} />
  </div>
  <p class="wrap cs-logo-note">Logo {name} · vectorisé et animé</p>
</section>

{sym && (
  <section class="cs-symbol wrap" data-mouse-scope>
    <div class="sym-tile" style={`--sbg:${sbg}`} data-sym data-mouse="-18"><div class="sym-svg" set:html={sym} /></div>
    <div class="sym-copy">
      <span class="cs-kicker" style="color:var(--p1)">Le symbole</span>
      <p class="display" style="font-size:clamp(30px,3.6vw,52px);font-weight:600;margin:0">Une forme qui porte toute la marque.</p>
      <p class="muted" style="margin:0;font-size:18px;line-height:1.6">Le symbole fonctionne seul : icône d'application, réseaux sociaux, tampon, signalétique. Survole-le pour le faire réagir.</p>
    </div>
  </section>
)}
