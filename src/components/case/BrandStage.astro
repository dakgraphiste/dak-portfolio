---
// Scène logo : le logo original (image fidèle, non vectorisée) se révèle et s'anime.
interface Props { brand: { logo: string; symbol?: string }; name: string }
const { brand, name } = Astro.props;
// couleur de fond de chaque logo (relevée sur les planches) pour un rendu sans bord
const BG: Record<string, string> = {
  'orika-logo': '#FAF1F2', 'orika-symbole': '#CF3956', 'chapn-logo': '#C8F459', 'chapn-symbole': '#5D2BBE',
  'lumora-logo': '#380E0F', 'pakinou-logo': '#F3E8D2', 'pakinou-symbole': '#3F170B'
};
const ink = (hex: string) => { const n = parseInt(hex.slice(1), 16), l = (0.299 * (n >> 16) + 0.587 * ((n >> 8) & 255) + 0.114 * (n & 255)) / 255; return l > 0.6 ? '#141010' : '#FFFFFF'; };
const src = (n: string) => `/images/projets/${n}.webp`;
const lbg = BG[brand.logo] || '#111', sbg = brand.symbol ? BG[brand.symbol] || '#111' : '#111';
---
<section class="cs-logo" style={`--lbg:${lbg};--link:${ink(lbg)}`} data-logo-stage data-mouse-scope>
  <div class="wrap cs-logo-head">
    <span class="cs-kicker">Le logo</span>
    <button type="button" class="cs-replay" data-replay aria-label="Rejouer l'animation du logo">Rejouer ↺</button>
  </div>
  <div class="cs-logo-canvas">
    <div class="logo-halo" aria-hidden="true"></div>
    <div class="logo-img" data-mouse="-22">
      <img src={src(brand.logo)} alt={`Logo ${name}`} loading="lazy" />
      <span class="logo-sheen" aria-hidden="true"></span>
    </div>
  </div>
  <p class="wrap cs-logo-note">Logo {name}</p>
</section>

{brand.symbol && (
  <section class="cs-symbol wrap" data-mouse-scope>
    <div class="sym-tile" style={`--sbg:${sbg}`} data-sym data-mouse="-18"><img class="sym-img" src={src(brand.symbol)} alt={`Symbole ${name}`} loading="lazy" /></div>
    <div class="sym-copy">
      <span class="cs-kicker" style="color:var(--p1)">Le symbole</span>
      <p class="display" style="font-size:clamp(30px,3.6vw,52px);font-weight:600;margin:0">Une forme qui porte toute la marque.</p>
      <p class="muted" style="margin:0;font-size:18px;line-height:1.6">Le symbole fonctionne seul : icône d'application, réseaux sociaux, tampon, signalétique. Survole-le pour le faire réagir.</p>
    </div>
  </section>
)}
