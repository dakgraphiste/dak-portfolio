---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
import Mascot from '../components/Mascot.astro';
---
<Base title="Contact — devis et projets" footer={false} whatsapp={false} description="Contacter Davy Aymard Kouassi (Dak.graphiste), graphiste à Abidjan : identité visuelle, affiches, réseaux sociaux, formations." image="/images/og/contact.jpg">
  <section class="ct" data-ct>
    <div class="ct-blob c1" aria-hidden="true"></div><div class="ct-blob c2" aria-hidden="true"></div><div class="ct-blob c3" aria-hidden="true" data-follow></div>
    <Mascot pose={2} bubble="Je t'écoute !" class="ct-masc" />
    <div class="ct-inner">
      <span class="eyebrow" data-reveal>Contact · {SITE.city}</span>
      <h1 class="display" data-lines style="font-size:clamp(52px,8.5vw,128px);font-weight:600;text-align:center"><span class="line-mask"><span>Un projet</span></span><span class="line-mask"><span>en tête ?</span></span></h1>
      <p data-reveal=".3" style="margin:0;max-width:520px;font-size:19px;line-height:1.5;opacity:.75;text-align:center">Écris-moi : je te réponds avec quelques questions pour cadrer ton projet ou ta formation. Le plus rapide : <a href={SITE.whatsapp} target="_blank" rel="noopener noreferrer" style="text-decoration:underline;text-underline-offset:4px">WhatsApp</a>.</p>

      <form class="ct-form" action={SITE.formAction} method="POST" data-form>
        <!-- piège anti-spam : champ invisible que seuls les robots remplissent -->
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
        <div class="glass">
          <label for="email" class="sr-only">Ton adresse email</label>
          <input id="email" name="email" type="email" required maxlength="120" placeholder="ton@email.com" autocomplete="email" />
          <button type="submit" class="gbtn">Envoyer</button>
        </div>
        <details class="more">
          <summary>Ou remplir le formulaire détaillé</summary>
          <div class="fields">
            <label>Nom<input name="nom" type="text" autocomplete="name" maxlength="100" /></label>
            <label>Type de projet<select name="type"><option>Identité visuelle</option><option>Affiche / print</option><option>Publicité / packaging</option><option>Réseaux sociaux</option><option>Retouche photo</option><option>Formation</option><option>Autre</option></select></label>
            <label>Budget<select name="budget"><option>Je ne sais pas encore</option><option>Moins de 100 000 FCFA</option><option>100 000 – 300 000 FCFA</option><option>300 000 – 700 000 FCFA</option><option>Plus de 700 000 FCFA</option></select></label>
            <label>Délai souhaité<input name="delai" type="text" placeholder="ex. mars 2027" maxlength="60" /></label>
            <label class="full">Message<textarea name="message" rows="4" maxlength="3000"></textarea></label>
          </div>
        </details>
        <p class="status" role="status" data-status></p>
      </form>

      <div class="ct-links">
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <a href={SITE.phoneHref}>{SITE.phone}</a>
        <a href={SITE.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp ↗</a>
        <a href={SITE.behance} target="_blank" rel="noopener noreferrer">Behance ↗</a>
        <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        <a href={SITE.facebook} target="_blank" rel="noopener noreferrer">Facebook ↗</a>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  .ct { position: relative; min-height: 100svh; overflow: hidden; background: #0A0605; color: #FFF4EE; display: flex; align-items: center; justify-content: center; padding: 140px 20px 80px; }
  :root:not([data-theme="dark"]) .ct { background: #FFF4EE; color: #1A0B06; }
  .ct-blob { position: absolute; border-radius: 50%; pointer-events: none; }
  .ct-blob.c1 { left: -10%; bottom: -20%; width: 620px; height: 620px; background: #FF5A1F; filter: blur(110px); opacity: .6; animation: drift1 14s ease-in-out infinite; }
  .ct-blob.c2 { right: -8%; top: -18%; width: 560px; height: 560px; background: #7A2208; filter: blur(120px); opacity: .6; animation: drift2 18s ease-in-out infinite; }
  .ct-blob.c3 { left: 0; top: 0; width: 520px; height: 520px; margin: -260px 0 0 -260px; background: #FF8A4C; filter: blur(100px); opacity: .45; }
  :root:not([data-theme="dark"]) .ct-blob.c2 { background: #FFB38F; }
  @keyframes drift1 { 50% { transform: translate(120px, 60px); } }
  @keyframes drift2 { 50% { transform: translate(-140px, -40px); } }
  .ct .eyebrow { color: inherit; opacity: .85; }
  .ct-masc { left: clamp(10px, 6vw, 120px); }
  @media (max-width: 960px) { .ct-masc { display: none; } }
  .ct-inner { position: relative; z-index: 2; width: 100%; max-width: 960px; display: flex; flex-direction: column; align-items: center; gap: 28px; }
  .ct-form { width: 100%; max-width: 760px; display: flex; flex-direction: column; gap: 16px; margin-top: 16px; }
  .glass { display: flex; align-items: center; gap: 12px; padding: 12px 12px 12px 32px; border-radius: 999px; background: rgba(120,40,10,.25); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); animation: glow 3.2s ease-in-out infinite; }
  :root:not([data-theme="dark"]) .glass { background: rgba(255,255,255,.6); }
  @keyframes glow { 0%,100% { box-shadow: 0 0 0 1.5px rgba(255,160,110,.7), 0 0 28px 2px rgba(255,90,31,.45), inset 0 1px 0 rgba(255,255,255,.35); } 50% { box-shadow: 0 0 0 1.5px rgba(255,160,110,.7), 0 0 56px 8px rgba(255,90,31,.45), inset 0 1px 0 rgba(255,255,255,.45); } }
  .glass input { flex: 1 1 auto; min-width: 0; height: 64px; border: 0; background: transparent; color: inherit; font: 500 clamp(18px, 2.4vw, 28px) var(--font-display); outline: none; }
  .glass input::placeholder { color: inherit; opacity: .55; }
  .gbtn { flex: 0 0 auto; min-height: 64px; padding: 0 36px; border-radius: 999px; border: 0; background: var(--accent); color: #0A0A0A; font-weight: 700; font-size: 18px; cursor: pointer; transition: transform .35s var(--spring), filter .3s; }
  .gbtn:hover { transform: scale(1.04); filter: brightness(1.1); }
  .more summary { cursor: pointer; text-align: center; opacity: .75; text-decoration: underline; text-underline-offset: 5px; list-style: none; padding: 12px; }
  .more summary::-webkit-details-marker { display: none; }
  .fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: 12px; }
  .fields label { display: flex; flex-direction: column; gap: 8px; font-size: 14px; opacity: .9; }
  .fields .full { grid-column: 1 / -1; }
  .fields input, .fields select, .fields textarea { min-height: 52px; padding: 12px 16px; border-radius: 14px; border: 1px solid rgba(255,160,110,.4); background: rgba(255,255,255,.06); color: inherit; font: 16px var(--font-body); }
  .fields input:focus, .fields select:focus, .fields textarea:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  @media (max-width: 600px) { .fields { grid-template-columns: 1fr; } .glass { flex-wrap: wrap; border-radius: 28px; padding: 12px; } .glass input { padding-left: 12px; } .gbtn { width: 100%; } }
  .status { margin: 0; text-align: center; min-height: 1.4em; font-weight: 600; }
  .ct-links { display: flex; gap: 28px; flex-wrap: wrap; justify-content: center; font-size: 16px; font-weight: 500; margin-top: 16px; }
  .ct-links a:hover { color: var(--accent); }
</style>

<script>
  import { gsap, finePointer, reduced } from '../scripts/core';
  const ct = document.querySelector<HTMLElement>('[data-ct]')!;
  const follow = ct.querySelector<HTMLElement>('[data-follow]')!;
  gsap.set(follow, { x: window.innerWidth / 2, y: window.innerHeight / 2 });
  if (finePointer && !reduced) ct.addEventListener('mousemove', (e) => { const r = ct.getBoundingClientRect(); gsap.to(follow, { x: e.clientX - r.left, y: e.clientY - r.top, duration: 1.2, ease: 'power3.out' }); });

  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const status = form.querySelector<HTMLElement>('[data-status]')!;
  let lastSend = 0;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const trap = form.querySelector<HTMLInputElement>('[name="_gotcha"]');
    if (trap && trap.value) return; // robot détecté : on ignore
    if (Date.now() - lastSend < 15000) { status.textContent = 'Message déjà envoyé, merci de patienter quelques secondes.'; return; }
    lastSend = Date.now();
    if (form.action.includes('VOTRE_ID')) {
      const d = new FormData(form);
      const body = [...d.entries()].map(([k, v]) => `${k} : ${v}`).join('\n');
      window.location.href = `mailto:dakgraphiste@gmail.com?subject=${encodeURIComponent('Nouveau projet')}&body=${encodeURIComponent(body)}`;
      return;
    }
    status.textContent = 'Envoi…';
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      status.textContent = res.ok ? 'Message envoyé — merci ! Je te réponds vite.' : "Oups, l'envoi a échoué. Écris-moi à dakgraphiste@gmail.com.";
      if (res.ok) form.reset();
    } catch { status.textContent = "Oups, l'envoi a échoué. Écris-moi à dakgraphiste@gmail.com."; }
  });
</script>
