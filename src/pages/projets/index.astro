---
import Base from '../../layouts/Base.astro';
import Mascot from '../../components/Mascot.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { PROJECTS, CATEGORIES, catSlug } from '../../data/site';
const cats = ['Tout', ...CATEGORIES];
---
<Base title="Projets" description="Projets de Davy Aymard Kouassi (Dak.graphiste) : identités visuelles, affiches, publicité, packaging, réseaux sociaux et retouche photo." image="/images/og/projets.jpg">
  <section class="wrap" style="padding-top:150px;display:flex;justify-content:space-between;align-items:flex-end;gap:24px;flex-wrap:wrap">
    <h1 class="display" data-lines style="font-size:clamp(52px,8vw,124px);font-weight:600"><span class="line-mask"><span>Projets</span></span><span class="line-mask"><span>sélectionnés</span></span></h1>
    <p class="muted" data-reveal=".3" style="margin:0;max-width:360px;font-size:17px;line-height:1.5">Identités, réseaux sociaux, campagnes, packagings et affiches, pour des marques locales et internationales, en agence et en freelance.</p>
  </section>

  <div class="marquee" aria-hidden="true" style="border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:18px 0">
    <div class="marquee-track" style="font-family:var(--font-display);font-weight:600;font-size:64px;letter-spacing:-0.03em;white-space:nowrap">
      <span style="padding-right:40px">Identité visuelle — <span class="outline">Réseaux sociaux</span> — Campagnes — <span class="outline">Packaging</span> — Affiches — <span class="outline">Key visuals</span> — </span>
      <span style="padding-right:40px">Identité visuelle — <span class="outline">Réseaux sociaux</span> — Campagnes — <span class="outline">Packaging</span> — Affiches — <span class="outline">Key visuals</span> — </span>
    </div>
  </div>

  <section class="wrap" data-filter-scope style="padding-top:72px;padding-bottom:110px">
    <div class="section-title">
      <h2>Tous les projets <span class="muted" data-count>({PROJECTS.length})</span></h2>
      <div class="chips" role="group" aria-label="Filtrer par catégorie">
        {cats.map((c, i) => <button type="button" class="chip" data-filter={c} data-slug={catSlug(c)} aria-pressed={i === 0 ? 'true' : 'false'}>{c}</button>)}
      </div>
    </div>
    <div class="pgrid">{PROJECTS.map((p) => <ProjectCard project={p} />)}</div>
  </section>

  <div class="cta-band"><Mascot pose={1} bubble="Let'z Go !" /><p>Un projet en tête ?</p><a href="/contact" class="btn btn-fg">Me contacter →</a></div>
</Base>

