---
import Base from '../../layouts/Base.astro';
import { PROJECTS, sm, srcset, filled } from '../../data/site';
export function getStaticPaths() {
  return PROJECTS.map((p, i) => ({ params: { slug: p.slug }, props: { project: p, index: i, next: PROJECTS[(i + 1) % PROJECTS.length] } }));
}
const { project: p, index, next } = Astro.props;
const meta = [['Client', p.client], ['Année', p.year], ['Catégorie', p.categoryLabel], ['Mon rôle', p.role], ['Livrables', p.deliverables]].filter(([, v]) => filled(v));
// seuls les textes remplis s'affichent ; sinon un résumé du projet
let blocks = [['Le brief', p.brief], ['Le concept', p.concept], ['Le challenge', p.challenge]].filter(([, t]) => filled(t));
if (!blocks.length) blocks = [['Le projet', `${p.categoryLabel} ${filled(p.client) ? `pour ${p.client}` : ''}. Livrables : ${p.deliverables.toLowerCase()}. Retrouve le projet complet, avec toutes ses déclinaisons, sur Behance.`.replace(' .', '.')]];
const numbered = blocks.map(([h, t], i) => [String(i + 1).padStart(2, '0'), h, t]);
const gallery = [...new Set(p.gallery)];
---
<Base title={p.title} description={`${p.title} — ${p.categoryLabel}. Étude de cas par Davy Aymard Kouassi (Dak.graphiste), graphiste à Abidjan.`} image={p.cover}>
  <section class="cs-hero" data-mouse-scope>
    <div class="cs-bg" data-mouse="-40"><img src={p.cover} alt={p.title} fetchpriority="high" /></div>
    <div class="cs-shade" aria-hidden="true"></div>
    <div class="cs-glow" aria-hidden="true"></div>
    <div class="cs-head">
      <div class="chips" data-reveal=".2"><span class="tag tag-accent">{p.categoryLabel}</span><span class="tag">Étude de cas {String(index + 1).padStart(2, '0')} / {PROJECTS.length}</span></div>
      <h1 class="display" data-lines style="font-size:clamp(48px,8vw,128px)"><span class="line-mask"><span>{p.title}</span></span></h1>
    </div>
  </section>

  <section class="wrap" style="padding-top:56px">
    <div class="cs-meta">{meta.map(([k, v]) => <div><span class="eyebrow">{k}</span><span class="v">{v}</span></div>)}</div>
  </section>

  <section class="wrap" style="padding-top:40px;padding-bottom:80px">
    {numbered.map(([n, h, t]) => (
      <div class="cs-blk" data-reveal><span style="font-weight:600;color:var(--accent-text)">{n}</span><h2>{h}</h2><p class="muted">{t}</p></div>
    ))}
  </section>

  <section class="wrap cs-gallery" data-mouse-scope style="padding-bottom:40px">
    <div class="g1" data-mouse="-14"><img src={gallery[0]} alt={`${p.title} — visuel principal`} loading="lazy" /></div>
    {gallery.slice(1, 3).map((g, i) => <div class={i ? 'g3' : 'g2'} data-mouse={i ? 18 : -24}><img src={g} srcset={srcset(g)} sizes="(max-width: 860px) 100vw, 50vw" alt={`${p.title} — visuel ${i + 2}`} loading="lazy" /></div>)}
  </section>
  <p class="wrap" style="padding-bottom:110px"><a href={p.behance} target="_blank" rel="noopener noreferrer" class="btn btn-line">Voir le projet complet sur Behance ↗</a></p>

  <a href={`/projets/${next.slug}`} class="cs-next" data-cursor="Suivant">
    <span style="display:flex;flex-direction:column;gap:14px;position:relative;z-index:2"><span class="eyebrow" style="color:#fff;opacity:.85">Projet suivant</span><span class="display" style="font-size:clamp(40px,6vw,96px)">{next.title}</span></span>
    <span class="nimg" aria-hidden="true"><img src={sm(next.cover)} alt="" loading="lazy" /></span>
    <span class="arr">→</span>
  </a>
</Base>

<style is:global>
  .cs-hero { position: relative; height: 92vh; min-height: 620px; overflow: hidden; background: #0A0A0A; color: #fff; }
  .cs-bg { position: absolute; inset: -40px; transition: translate 1s var(--ease); }
  .cs-bg img { width: 100%; height: 100%; object-fit: cover; animation: cs-zoom 2.4s var(--ease) both; }
  @keyframes cs-zoom { from { transform: scale(1.18); } to { transform: scale(1.04); } }
  .cs-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,10,10,.55) 0%, rgba(10,10,10,0) 30%, rgba(42,14,5,.55) 62%, #0A0A0A 100%); }
  .cs-glow { position: absolute; left: -10%; bottom: -30%; width: 70%; height: 70%; border-radius: 50%; background: var(--accent); filter: blur(140px); opacity: .45; }
  .cs-head { position: absolute; left: var(--gutter); right: var(--gutter); bottom: 56px; display: flex; flex-direction: column; gap: 22px; }
  .tag { padding: 9px 16px; border-radius: 999px; border: 1px solid rgba(255,255,255,.4); font-size: 14px; font-weight: 600; }
  .tag-accent { background: var(--accent); border-color: var(--accent); color: #0A0A0A; font-weight: 700; }
  .cs-meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .cs-meta > div { padding: 26px 24px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: 10px; transition: background-color .35s; }
  .cs-meta > div:hover { background: rgba(255,90,31,.12); }
  .cs-meta .v { font-size: 20px; font-weight: 500; }
  .cs-blk { position: relative; display: grid; grid-template-columns: 80px minmax(160px, 260px) minmax(0, 1fr); gap: 32px; padding: 44px 0; border-top: 1px solid var(--line); transition: padding-left .45s var(--ease); }
  .cs-blk:last-child { border-bottom: 1px solid var(--line); }
  .cs-blk::before { content: ''; position: absolute; left: 0; top: -1px; width: 0; height: 2px; background: var(--accent); transition: width .6s var(--ease); }
  .cs-blk:hover::before { width: 100%; }
  .cs-blk:hover { padding-left: 16px; }
  .cs-blk h2 { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 40px; letter-spacing: -0.04em; }
  .cs-blk p { margin: 0; font-size: 20px; line-height: 1.6; }
  @media (max-width: 760px) { .cs-blk { grid-template-columns: 1fr; gap: 12px; } }
  .cs-gallery { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 24px; align-items: start; }
  .cs-gallery > div { border-radius: 28px; overflow: hidden; transition: translate 1s var(--ease); }
  .cs-gallery img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  .cs-gallery > div:hover img { transform: scale(1.04); }
  .cs-gallery .g1 { grid-column: 1 / -1; aspect-ratio: 16 / 7; }
  .cs-gallery .g2, .cs-gallery .g3 { aspect-ratio: 4 / 5; }
  .cs-gallery .g3 { margin-top: 80px; }
  .cs-next { position: relative; display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 120px var(--gutter); background: var(--grad); color: #fff; overflow: hidden; }
  .cs-next .nimg { position: absolute; right: 22%; top: 50%; margin-top: -117px; width: 300px; height: 234px; border-radius: 20px; overflow: hidden; box-shadow: 0 30px 60px -20px rgba(0,0,0,.6); opacity: 0; transform: scale(.8) rotate(-6deg); transition: all .5s cubic-bezier(.2,.9,.25,1.2); }
  .cs-next .nimg img { width: 100%; height: 100%; object-fit: cover; }
  .cs-next:hover .nimg { opacity: 1; transform: scale(1) rotate(-4deg); }
  .cs-next .arr { font-size: 72px; line-height: 1; position: relative; z-index: 2; transition: transform .5s var(--ease); }
  .cs-next:hover .arr { transform: translateX(16px) rotate(-45deg); }
</style>
