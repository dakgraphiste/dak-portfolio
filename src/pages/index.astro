  /* services */
  .services { position: relative; padding-top: 120px; padding-bottom: 120px; }
  .srow { position: relative; overflow: hidden; display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 34px 16px; border-top: 1px solid var(--line); }
  .srow-end { border-top: 1px solid var(--line); }
  .srow .fill { position: absolute; inset: 0; background: var(--accent); transform: scaleY(0); transform-origin: 50% 100%; transition: transform .55s cubic-bezier(.7,0,.2,1); }
