---
import Base from '../layouts/Base.astro';
import Mascot from '../components/Mascot.astro';
import { PRODUCTS, SHOP_OPEN } from '../data/shop';
import { PROJECTS, CLIENTS, sm, srcset } from '../data/site';

const FAN = ['orika', 'budweiser', 'fanmilk', 'posters-coupe-du-monde-2026', 'bonnet-rouge', 'superclean', 'chapn', 'yango', 'bavaria-smalt', 'posters-can-2025', 'abodjama', 'totalenergies-pakinou'];
const fan = FAN.map((slug) => PROJECTS.find((p) => p.slug === slug)!).map((p, i) => ({ img: p.poster, a: -6 - i * 15, d: i * 0.07, z: 30 - i }));
const P = Object.fromEntries(PROJECTS.map((p) => [p.slug, p]));

const IC = {
  Ps: ['Ps', '#001E36', '#31A8FF', 'Photoshop'], Ai: ['Ai', '#330000', '#FF9A00', 'Illustrator'], Ae: ['Ae', '#00005B', '#9999FF', 'After Effects'],
  Pr: ['Pr', '#1D0031', '#EA77FF', 'Premiere Pro'], IA: ['IA', '#FF5A1F', '#0A0A0A', 'IA générative'],
  Fb: ['f', '#1877F2', '#FFFFFF', 'Facebook'], Be: ['Bē', '#1769FF', '#FFFFFF', 'Behance'], In: ['in', '#0A66C2', '#FFFFFF', 'LinkedIn']
} as Record<string, string[]>;
const KW: Record<string, string[]> = { 'Dak.': ['Be', 'In'], 'identités,': ['Ai', 'Ps'], campagnes: ['Ps', 'Ae'], communication: ['Pr', 'IA'], marques: ['Fb', 'Be'] };
const FADED = new Set(['Je', "m'appelle", 'On', 'Depuis', 'plus', 'de', 'je', 'des', 'et', 'pour', 'qui', 'ne', 'peuvent', 'pas', 'se', 'permettre', 'construis', 'atouts']);
const words = "Je m'appelle Davy Aymard Kouassi. On m'appelle Dak. Depuis plus de 7 ans, je construis des identités, des campagnes et des atouts de communication pour des marques qui ne peuvent pas se permettre l'à-peu-près.".split(' ');

const services = [
  ['01', 'Identité visuelle', P['orika'].cover, '/projets'],
  ['02', 'Réseaux sociaux', P['budweiser'].cover, '/projets'],
  ['03', 'Campagnes & key visuals', P['totalenergies-rentree'].cover, '/projets'],
  ['04', 'Packaging & produit', P['trajolou'].cover, '/projets'],
  ['05', 'Affiches & sport', P['posters-can-2025'].cover, '/projets'],
  ['06', 'Formations', P['chapn'].cover, '/formations']
];
const recent = ['orika', 'budweiser', 'totalenergies-pakinou', 'chapn', 'posters-coupe-du-monde-2026', 'trajolou', 'la-vache-qui-rit', 'air-elegance-can'].map((s) => P[s]);
const acc1 = [
  { p: P['chapn'], cap: "Chap'n · identité", pos: 'left:4%;top:12%', rot: -8, w: 300, k: -40, stk: 'Identité complète' },
  { p: P['orika'], cap: 'Orika · cosmétique', pos: 'left:8%;bottom:9%', rot: 6, w: 240, k: -20 },
  { p: P['lumora'], cap: 'Lumora · identité', pos: 'right:5%;top:16%', rot: 7, w: 270, k: 30, stk: 'Logo + charte' },
  { p: P['bronze'], cap: 'Bronzé · logo & packaging', pos: 'right:9%;bottom:8%', rot: -5, w: 230, k: 18 }
];
const acc2 = [
  { p: P['posters-can-2025'], cap: 'CAN 2025 · posters', pos: 'left:5%;top:14%', rot: -7, w: 290, k: -36, stk: 'Série sport' },
  { p: P['totalenergies-pakinou'], cap: 'TotalEnergies · KV', pos: 'left:10%;bottom:8%', rot: 5, w: 230, k: -18 },
  { p: P['air-elegance-can'], cap: 'Air Elegance · KV', pos: 'right:4%;top:12%', rot: 8, w: 300, k: 32, stk: 'Print & digital' },
  { p: P['king-fish'], cap: 'King Fish · affiche', pos: 'right:10%;bottom:9%', rot: -6, w: 230, k: 16 }
];
const logoStyles = [
  "font-family:var(--font-display);font-weight:800;font-size:40px;letter-spacing:-0.04em",
  "font-family:var(--font-body);font-weight:400;font-size:36px;letter-spacing:.02em",
  "font-family:var(--font-display);font-weight:800;font-size:34px;letter-spacing:.04em;text-transform:uppercase",
  "font-family:var(--font-body);font-style:italic;font-weight:800;font-size:40px;letter-spacing:-0.03em;text-transform:uppercase",
  "font-family:'Pacifico',cursive;font-size:32px",
  "font-family:var(--font-serif);font-style:italic;font-weight:600;font-size:34px",
  "font-family:var(--font-display);font-weight:700;font-size:30px;letter-spacing:.18em;text-transform:uppercase",
  "font-family:'Pacifico',cursive;font-size:30px",
  "font-family:var(--font-body);font-weight:800;font-size:32px;letter-spacing:-0.04em"
];
const logos = CLIENTS.map((n, i) => ({ n, st: logoStyles[i % logoStyles.length] }));
const row2 = logos.slice(4).concat(logos.slice(0, 4));
const brand = 'dak.graphiste'.split('');
---
<Base title="Accueil">
  <!-- Intro -->
  <div class="loader" aria-hidden="true">
    <span class="eyebrow" style="color:#A6A6AC">Davy Aymard Kouassi — portfolio</span>
    <div class="loader-word">{brand.map((c, i) => <span style={`animation-delay:${0.05 + i * 0.035}s${c === '.' ? ';color:var(--accent)' : ''}`}>{c}</span>)}</div>
    <div class="loader-foot"><span>Chargement de l'univers</span><span class="counter"><span>000</span><span>025</span><span>050</span><span>075</span><span>100</span></span></div>
  </div>

  <!-- Hero -->
  <section class="hero" data-hero data-cursor-hide>
    <div class="fan-scene" aria-hidden="true">
      <div class="fan" data-fan>
        {fan.map((c) => <div class="fan-card" style={`--a:${c.a}deg;animation-delay:${c.d}s;z-index:${c.z}`}><img src={sm(c.img)} alt="" decoding="async" /></div>)}
      </div>
    </div>
    <h1 class="hero-title" aria-label="Dak, graphiste"><span style="animation-delay:1.6s">D</span><span style="animation-delay:1.68s">a</span><span style="animation-delay:1.76s">k</span><span style="animation-delay:1.84s">.</span></h1>
    <div class="hero-id appear"><b>Davy Aymard Kouassi</b><span class="muted">Graphiste senior · Abidjan, Côte d'Ivoire</span></div>
    <div class="badge" aria-hidden="true">
      <svg width="132" height="132" viewBox="0 0 132 132"><defs><path id="circ" d="M66 66m-50 0a50 50 0 1 1 100 0a50 50 0 1 1 -100 0" /></defs><text style="font:600 12.5px Inter,sans-serif;letter-spacing:3px;fill:currentColor;text-transform:uppercase"><textPath href="#circ">Disponible pour vos projets — 2026 — </textPath></text><circle cx="66" cy="66" r="7" fill="#FF5A1F" /></svg>
    </div>
    <div class="hero-foot appear">
      <p>Je conçois des <span class="rot-wrap"><span class="rot"><span>identités.</span><span>affiches.</span><span>logos.</span><span>univers.</span><span>identités.</span></span></span></p>
      <span class="muted only-hover">Survole l'écran ↗</span><span class="muted only-touch">Fais défiler ↓</span>
    </div>
    <div class="spot" aria-hidden="true" data-spot>
      <span>Créons<br />l'inoubliable.</span>
      <b>Davy Aymard Kouassi — dak.graphiste</b>
    </div>
  </section>

  <!-- Manifeste -->
  <section class="manifesto">
    <div class="wrap mf-grid">
      <div class="mf-side"><span class="eyebrow">Manifeste</span><span style="opacity:.6;font-size:15px">Survole les mots soulignés</span></div>
      <p class="mf-text" data-reveal>
        {words.map((w) => KW[w]
          ? <span class="kw">{w}<span class="u"></span>{KW[w].map((n, j) => <span class="ico" style={`--ix:${j ? 38 : -38}px;--ir:${j ? 10 : -10}deg;--id:${j * 0.08}s`}><span class="tile" style={`background:${IC[n][1]};color:${IC[n][2]}`}>{IC[n][0]}</span></span>)}</span>
          : <span style={FADED.has(w) ? 'opacity:.62' : undefined}>{w}</span>)}
      </p>
    </div>
  </section>

  <!-- Accroche 1 -->
  <section class="hook hook-light" data-mouse-scope>
    {acc1.map((f) => (
      <div class="frm" style={f.pos} data-mouse={f.k}>
        <a href={`/projets/${f.p.slug}`} class="fr" style={`--rot:${f.rot}deg;width:${f.w}px`} data-cursor="Voir">
          <img src={f.p.cover} srcset={srcset(f.p.cover)} sizes="300px" alt="" loading="lazy" /><span class="cap">{f.cap}</span>
          {f.stk && <span class="stk">{f.stk}</span>}
        </a>
      </div>
    ))}
    <div class="hook-inner">
      <span class="handle">@dak.graphiste</span>
      <p class="acc" data-reveal>Ta marque<br /><span class="bx">« mérite »</span>plus<br />qu’un <span class="it">« simple</span><br /><span class="it">logo »</span>.</p>
      <a href="/contact" class="cta-o">Je veux une vraie identité →</a>
    </div>
  </section>

  <!-- Services -->
  <section class="services wrap" data-preview-scope>
    <div class="section-title"><h2>Ce que je fais</h2><span class="muted">Survole une ligne</span></div>
    {services.map((s) => (
      <a href={s[3]} class="srow" data-preview-src={sm(s[2])}>
        <span class="fill"></span>
        <span class="txt"><span class="num">{s[0]}</span><span class="name">{s[1]}</span></span>
        <span class="arr">→</span>
      </a>
    ))}
    <div class="srow-end"></div>
    <div class="preview" data-preview aria-hidden="true"><img src={sm(services[0][2])} alt="" loading="lazy" /></div>
  </section>

  <!-- Projets récents -->
  <section class="recent" data-strip>
    <div class="wrap section-title"><h2>Projets récents</h2><a href="/projets" style="font-weight:600;text-decoration:underline;text-underline-offset:6px">Tous les projets →</a></div>
    <div class="strip" data-strip-track>
      {recent.map((p) => (
        <a href={`/projets/${p.slug}`} class="tcard" data-cursor="Voir">
          <img class="tc-img" src={p.poster} srcset={srcset(p.poster)} sizes="340px" alt="" loading="lazy" />
          {p.gallery.slice(0, 3).map((g) => <span class={p.gallery.length > 1 ? 'casc real' : 'casc'} aria-hidden="true"><img src={sm(g)} alt="" loading="lazy" /></span>)}
          <span class="cap">{p.title}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Jumelles : projet à la une -->
  <section class="bino" data-bino data-cursor-hide>
    <img class="bino-img" src={P['kpalo-energie'].cover} alt="Projet à la une : KPALO Énergie" loading="lazy" />
    <svg class="bino-view" viewBox="0 0 3200 2200" aria-hidden="true">
      <defs>
        <mask id="binoMask"><rect width="3200" height="2200" fill="#fff" /><circle cx="1390" cy="1100" r="260" fill="#000" /><circle cx="1810" cy="1100" r="260" fill="#000" /></mask>
        <radialGradient id="binoVig" cx="50%" cy="50%" r="50%"><stop offset="0.78" stop-color="#000" stop-opacity="0" /><stop offset="1" stop-color="#000" stop-opacity=".85" /></radialGradient>
      </defs>
      <rect width="3200" height="2200" fill="#050505" mask="url(#binoMask)" />
      <circle cx="1390" cy="1100" r="262" fill="url(#binoVig)" /><circle cx="1810" cy="1100" r="262" fill="url(#binoVig)" />
      <g stroke="#fff" stroke-width="2.5" fill="none" opacity=".9">
        <path d="M1440 980h-40v40 M1760 980h40v40 M1440 1220h-40v-40 M1760 1220h40v-40" />
        <path d="M1588 990l12 12l12 -12 M1588 1232l12 -12l12 12 M1588 1244l12 -12l12 12" />
        <path d="M1600 1085v30 M1585 1100h30 M1300 1100h250 M1650 1100h250" />
        <path d="M1320 1092v16 M1350 1095v10 M1380 1092v16 M1410 1095v10 M1440 1092v16 M1470 1095v10 M1500 1092v16 M1530 1095v10 M1670 1095v10 M1700 1092v16 M1730 1095v10 M1760 1092v16 M1790 1095v10 M1820 1092v16 M1850 1095v10 M1880 1092v16" />
        <path d="M1520 1180h160 M1520 1180v12 M1540 1180v7 M1560 1180v7 M1580 1180v7 M1600 1180v14 M1620 1180v7 M1640 1180v7 M1660 1180v7 M1680 1180v12" />
        <path d="M1170 1030h14 M1170 1065h14 M1170 1100h22 M1170 1135h14 M1170 1170h14 M2016 1030h14 M2016 1065h14 M2008 1100h22 M2016 1135h14 M2016 1170h14" />
      </g>
      <g style="font:600 22px Inter,sans-serif" fill="#fff" opacity=".85"><text x="1110" y="1037">100</text><text x="1110" y="1072">150</text><text x="1110" y="1107" fill="#FF5A1F">200</text><text x="1110" y="1142">250</text><text x="1110" y="1177">300</text></g>
    </svg>
    <div class="bino-hud tl"><span class="eyebrow">● Projet à la une</span><span class="display" style="font-size:clamp(36px,4.6vw,68px)">KPALO Énergie</span><span style="color:#D9D9DE">Campagne publicitaire · affichage</span></div>
    <div class="bino-hud tr">Zoom 2,5× · cible <span data-bino-xy>0720 / 0450</span></div>
    <div class="bino-hud bt"><span style="color:#D9D9DE"><span class="only-hover">Bouge la souris pour explorer le projet</span><span class="only-touch">Le viseur balaie le projet</span></span><a href="/projets/kpalo-energie" class="btn btn-accent">Voir l'étude de cas →</a></div>
  </section>

  {SHOP_OPEN && (
    <section class="wrap shop-teaser">
      <div class="section-title"><h2>La boutique</h2><a href="/boutique" style="font-weight:600;text-decoration:underline;text-underline-offset:6px">Mockups, extensions &amp; plus →</a></div>
      <div class="st-grid">
        {PRODUCTS.slice(0, 3).map((p) => (
          <a href={`/boutique/${p.slug}`} class="st-card" data-cursor="Voir">
            <span class="st-img"><img src={p.images[0]} alt="" loading="lazy" /></span>
            <span class="st-meta"><b>{p.name}</b><span>{p.price}</span></span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Clients -->
  <section class="logos marquee">
    <div class="logos-head">
      <span class="eyebrow">Marques accompagnées</span>
      <span class="display" style="font-size:clamp(30px,3.6vw,52px);font-weight:600">De Budweiser à TotalEnergies, en agence et en freelance.</span>
      <span style="color:#A6A6AC;font-size:17px">Identité, campagne, réseaux sociaux… Un projet ? <a href="/contact" style="color:#F4F4F2;text-decoration:underline;text-underline-offset:4px">Contactez-moi.</a></span>
    </div>
    <div class="marquee-track pausable logo-row">{[...logos, ...logos].map((l) => <span class="lpill"><span style={l.st}>{l.n}</span></span>)}</div>
    <div class="marquee-track rev pausable logo-row">{[...row2, ...row2].map((l) => <span class="lpill"><span style={l.st}>{l.n}</span></span>)}</div>
  </section>

  <!-- Accroche 2 -->
  <section class="hook hook-dark" data-mouse-scope>
    {acc2.map((f) => (
      <div class="frm" style={f.pos} data-mouse={f.k}>
        <a href={`/projets/${f.p.slug}`} class="fr" style={`--rot:${f.rot}deg;width:${f.w}px`} data-cursor="Voir">
          <img src={f.p.cover} srcset={srcset(f.p.cover)} sizes="300px" alt="" loading="lazy" /><span class="cap">{f.cap}</span>
          {f.stk && <span class="stk">{f.stk}</span>}
        </a>
      </div>
    ))}
    <div class="hook-inner">
      <span class="handle">@dak.graphiste</span>
      <p class="acc" data-reveal>Une affiche<br />qui <span class="bx">« arrête »</span><br />les <span class="it">passants.</span><br />Net.</p>
      <a href="/contact" class="cta-o">Créer mon affiche →</a>
    </div>
  </section>

  <div class="cta-band"><Mascot pose={1} bubble="Let'z Go !" /><p>Un projet ?<br />Une formation ?</p><span class="magnetic"><a href="/contact" class="btn" style="background:#0A0A0A;color:#fff">Écrire à Dak →</a></span></div>

  <div class="band-accent marquee" aria-hidden="true">
    <div class="marquee-track"><span style="padding-right:32px">IDENTITÉ — AFFICHE — LOGO — PACKAGING — FORMATION — DAK.GRAPHISTE — </span><span style="padding-right:32px">IDENTITÉ — AFFICHE — LOGO — PACKAGING — FORMATION — DAK.GRAPHISTE — </span></div>
  </div>
</Base>

<style is:global>
  /* intro */
  .loader { position: fixed; inset: 0; z-index: 100; background: #0A0A0A; color: #F4F4F2; display: flex; flex-direction: column; justify-content: space-between; padding: 40px var(--gutter); animation: lift .9s cubic-bezier(.8,0,.2,1) 1.4s forwards; pointer-events: none; }
  .loader-word { font-family: var(--font-display); font-weight: 800; font-size: clamp(56px, 11vw, 170px); letter-spacing: -0.05em; line-height: 1; overflow: hidden; padding-bottom: .08em; }
  .loader-word span { display: inline-block; animation: rise .9s cubic-bezier(.2,.8,.1,1) both; }
  .loader-foot { display: flex; justify-content: space-between; align-items: flex-end; color: #A6A6AC; font-size: 15px; }
  .counter { display: block; height: 1em; overflow: hidden; font-family: var(--font-display); font-weight: 700; font-size: 64px; line-height: 1; color: #F4F4F2; }
  .counter span { display: block; height: 1em; animation: count 1.2s steps(4) .1s forwards; }
  @keyframes lift { to { transform: translateY(-101%); } }
  @keyframes rise { from { transform: translateY(110%); } to { transform: translateY(0); } }
  @keyframes count { to { transform: translateY(-400%); } }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  .appear { animation: fadeUp .9s ease 2s both; }
  .no-intro .loader { display: none; }
  .no-intro .hero-title span, .no-intro .appear { animation-delay: .15s !important; }

  /* hero */
  .hero { position: relative; height: 100svh; min-height: 680px; overflow: hidden; }
  .fan-scene { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; perspective: 1400px; }
  .fan { position: relative; width: 280px; height: 380px; transform-style: preserve-3d; transition: transform .9s var(--ease); transform: translateX(140px) rotateZ(-26deg) rotateX(14deg) rotateY(-22deg); }
  .fan-card { position: absolute; inset: 0; border-radius: 30px; overflow: hidden; transform-origin: 0 50%; animation: fan 5s cubic-bezier(.65,0,.25,1) infinite alternate; box-shadow: 0 0 0 1px rgba(0,0,0,.08); }
  .fan-card img { width: 100%; height: 100%; object-fit: cover; }
  @keyframes fan { from { transform: rotateY(calc(var(--a) * .12)); } to { transform: rotateY(var(--a)); } }
  .hero-title { position: absolute; left: 0; right: 0; top: 50%; margin: -.5em 0 0; z-index: 4; text-align: center; pointer-events: none; mix-blend-mode: difference; color: #fff; font-family: var(--font-display); font-weight: 800; font-size: clamp(150px, 29vw, 440px); line-height: 1; letter-spacing: -0.07em; overflow: hidden; padding-bottom: .05em; }
  .hero-title span { display: inline-block; animation: rise 1.2s cubic-bezier(.2,.8,.1,1) both; }
  @media (max-width: 700px) { .hero-title { font-size: 29vw; white-space: nowrap; } }
  .hero-id { position: absolute; left: var(--gutter); top: 110px; z-index: 6; display: flex; flex-direction: column; gap: 4px; font-size: 15px; }
  .badge { position: absolute; right: clamp(110px, 11vw, 210px); top: 110px; z-index: 6; width: 132px; height: 132px; animation: spin 14s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .hero-foot { position: absolute; left: 0; right: 0; bottom: 0; z-index: 6; display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; padding: 32px var(--gutter); }
  .hero-foot p { margin: 0; display: flex; align-items: baseline; gap: .3em; font-family: var(--font-display); font-weight: 600; font-size: clamp(22px, 3vw, 40px); letter-spacing: -0.03em; line-height: 1.15; }
  .rot-wrap { display: inline-block; height: 1.15em; overflow: hidden; vertical-align: bottom; color: var(--accent-text); }
  .rot { display: flex; flex-direction: column; animation: words 8s cubic-bezier(.7,0,.2,1) 3s infinite; }
  .rot span { height: 1.15em; }
  @keyframes words { 0%,18% { transform: translateY(0); } 25%,43% { transform: translateY(-1.15em); } 50%,68% { transform: translateY(-2.3em); } 75%,93% { transform: translateY(-3.45em); } 100% { transform: translateY(-4.6em); } }
  .spot { position: absolute; inset: 0; z-index: 5; background: var(--accent); color: #0A0A0A; pointer-events: none; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24px; text-align: center; clip-path: circle(0px at 50% 50%); }
  .spot span { font-family: var(--font-display); font-weight: 800; font-size: clamp(64px, 11vw, 170px); line-height: .9; letter-spacing: -0.06em; }
  @media (max-width: 700px) { .badge { display: none; } .fan { transform: translate(80px, -30px) rotateZ(-26deg) rotateX(14deg) rotateY(-22deg) scale(.42); } }

  /* manifeste */
  .manifesto { background: var(--fg); color: var(--bg); padding: 140px 0 130px; }
  .mf-grid { display: flex; flex-wrap: wrap; gap: 48px 80px; }
  .mf-side { flex: 0 0 200px; display: flex; flex-direction: column; gap: 12px; }
  .mf-text { flex: 1 1 640px; min-width: 0; margin: 0; font-weight: 400; font-size: clamp(26px, 3.1vw, 44px); line-height: 1.35; letter-spacing: -0.02em; display: flex; flex-wrap: wrap; column-gap: .26em; }
  .kw { position: relative; display: inline-block; }
  .kw .u { position: absolute; left: 0; right: 0; bottom: .06em; height: 2px; background: var(--accent); transform: scaleX(.25); transform-origin: 0 50%; transition: transform .45s var(--ease); }
  .kw:hover .u { transform: scaleX(1); }
  .kw .ico { position: absolute; left: 50%; bottom: 100%; width: 66px; height: 66px; margin-left: -33px; perspective: 500px; pointer-events: none; opacity: 0; transform: translate(var(--ix), 20px) scale(.3) rotate(var(--ir)); transition: opacity .25s, transform .55s cubic-bezier(.2,.9,.25,1.35); transition-delay: var(--id); }
  .kw:hover .ico { opacity: 1; transform: translate(var(--ix), -18px) scale(1) rotate(var(--ir)); }
