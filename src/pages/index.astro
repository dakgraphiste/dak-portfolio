  .fr:hover { transform: rotate(0deg) scale(1.08); }
  .fr img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .fr .cap { position: absolute; left: 12px; bottom: 12px; font: 500 13px var(--font-body); color: #141010; }
  .fr .stk { position: absolute; right: -18px; top: -18px; padding: 10px 14px; border-radius: 999px; background: var(--accent); color: #0A0A0A; font: 700 13px var(--font-body); transform: rotate(8deg); box-shadow: 0 8px 20px -8px rgba(0,0,0,.4); }
