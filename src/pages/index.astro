  @media (hover: none) { .recent .strip { overflow-x: auto; width: auto; padding-top: 8px; scroll-snap-type: x mandatory; } .tcard { scroll-snap-align: start; width: 78vw; height: 100vw; max-height: 480px; } }

  /* jumelles */
  .bino { position: relative; height: 100vh; min-height: 640px; overflow: hidden; background: #000; color: #fff; }
