---
import '@fontsource/syne/500.css';
import '@fontsource/syne/600.css';
import '@fontsource/syne/700.css';
import '@fontsource/syne/800.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import '@fontsource/inter/800-italic.css';
import '@fontsource/playfair-display/400.css';
import '@fontsource/playfair-display/500.css';
import '@fontsource/playfair-display/500-italic.css';
import '@fontsource/playfair-display/600-italic.css';
import '@fontsource/playfair-display/700-italic.css';
import '@fontsource/pacifico/400.css';
import '../styles/global.css';
import { SITE, NAV as BASE_NAV } from '../data/site';
import { SHOP_OPEN } from '../data/shop';
// « Boutique » n'apparaît dans le menu que si un produit est publié
const NAV = SHOP_OPEN ? [...BASE_NAV.slice(0, 1), { href: '/boutique', label: 'Boutique' }, ...BASE_NAV.slice(1)] : BASE_NAV;

interface Props {
  title: string;
  description?: string;
  footer?: boolean;
  whatsapp?: boolean;
  image?: string;
  noindex?: boolean;
  jsonld?: Record<string, unknown>[]; // données structurées propres à la page
  type?: string;
}
const { title, description = `${SITE.name} — ${SITE.role} à ${SITE.city}. Identité visuelle, affiches, packaging, réseaux sociaux et formations.`, footer = true, image = '/images/og/accueil.jpg', whatsapp = true, noindex = false, jsonld = [], type = 'website' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const fullTitle = title === 'Accueil' ? `${SITE.brand} — ${SITE.name}, graphiste à Abidjan` : `${title} — ${SITE.brand}`;
const letters = SITE.brand.split('');
const ogImage = new URL(image, Astro.site).toString();
const canonical = new URL(path === '/' ? '/' : path, Astro.site).toString();
const origin = Astro.site!.toString().replace(/\/$/, '');
// Identité de Dak pour Google : personne + activité locale + site
const person = {
  '@type': 'Person', '@id': `${origin}/#davy`, name: SITE.name, alternateName: ['Dak', SITE.brand], jobTitle: SITE.role,
  email: SITE.email, telephone: SITE.phone, url: `${origin}/a-propos`, image: `${origin}/images/og/a-propos.jpg`,
  address: { '@type': 'PostalAddress', addressLocality: 'Abidjan', addressCountry: 'CI' },
  knowsAbout: ['Identité visuelle', 'Direction artistique', 'Design graphique', 'Affiches publicitaires', 'Packaging', 'Retouche photo', 'Réseaux sociaux'],
  sameAs: [SITE.behance, SITE.linkedin, SITE.facebook]
};
const graph = [
  person,
  { '@type': 'WebSite', '@id': `${origin}/#site`, url: `${origin}/`, name: SITE.brand, inLanguage: 'fr', publisher: { '@id': `${origin}/#davy` } },
  ...(path === '/' ? [{
    '@type': 'ProfessionalService', '@id': `${origin}/#studio`, name: `${SITE.brand} — graphiste à Abidjan`, url: `${origin}/`, image: ogImage,
    telephone: SITE.phone, email: SITE.email, priceRange: '$$', founder: { '@id': `${origin}/#davy` },
    address: { '@type': 'PostalAddress', addressLocality: 'Abidjan', addressCountry: 'CI' },
    geo: { '@type': 'GeoCoordinates', latitude: 5.3599, longitude: -4.0083 },
    areaServed: [{ '@type': 'Country', name: "Côte d'Ivoire" }, { '@type': 'Place', name: 'Afrique de l’Ouest' }, { '@type': 'Place', name: 'International (à distance)' }],
    serviceType: ['Identité visuelle', 'Affiches et campagnes publicitaires', 'Packaging', 'Design pour réseaux sociaux', 'Retouche photo', 'Formations en design graphique'],
    sameAs: [SITE.behance, SITE.linkedin, SITE.facebook]
  }] : []),
  ...jsonld
];
---
<!doctype html>
<html lang="fr" class="no-js">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
  {SITE.googleVerification && <meta name="google-site-verification" content={SITE.googleVerification} />}
  <meta name="author" content={SITE.name} />
  <meta name="geo.region" content="CI-AB" />
  <meta name="geo.placename" content="Abidjan" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE.brand} />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:image:alt" content={fullTitle} />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#0A0A0A" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <script is:inline src="/theme.js"></script>
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
</head>
<body>
  <a class="sr-only" href="#contenu">Aller au contenu</a>
  <header class="site-header">
    <a class="logo" href="/" aria-label="Accueil dak.graphiste">dak<span>.</span>graphiste</a>
    <nav class="nav" aria-label="Menu principal">
      {NAV.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <div class="header-actions">
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Basculer le thème clair ou sombre">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor" /></svg>
      </button>
      <button class="icon-btn menu-btn" type="button" data-menu aria-expanded="false" aria-controls="mobile-nav" aria-label="Ouvrir le menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg>
      </button>
    </div>
  </header>
  <nav class="mobile-nav" id="mobile-nav" aria-label="Menu mobile">
    <a href="/">Accueil</a>
    {NAV.map((n) => <a href={n.href}>{n.label}</a>)}
  </nav>

  <main id="contenu">
    <slot />
  </main>

  {footer && (
    <footer class="site-footer">
      <div class="wordmark" aria-label={SITE.brand}>
        {letters.map((l) => <span style={l === '.' ? 'color:var(--accent)' : undefined}>{l}</span>)}
      </div>
      <div class="footer-links">
        <span>© {new Date().getFullYear()} {SITE.name} · {SITE.city}</span>
        <nav aria-label="Coordonnées et réseaux">
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <a href={SITE.phoneHref}>{SITE.phone}</a>
          <a href={SITE.behance} target="_blank" rel="noopener noreferrer">Behance ↗</a>
          <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
          <a href={SITE.facebook} target="_blank" rel="noopener noreferrer">Facebook ↗</a>
        </nav>
      </div>
    </footer>
  )}

  {whatsapp && (
    <a href={`${SITE.whatsapp}?text=${encodeURIComponent('Bonjour Dak, je viens de ton site.')}`} class="wa-float" target="_blank" rel="noopener noreferrer" aria-label="Écrire à Dak sur WhatsApp" data-cursor="WhatsApp">
      <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 2s.9 2.3 1 2.5c.1.2 1.7 2.6 4.1 3.6 1.5.7 2.1.7 2.9.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.2-.2-.4-.2Z"/></svg>
    </a>
  )}
  <div class="cursor" aria-hidden="true"></div>
  <script>
    import '../scripts/core';
  </script>
</body>
</html>
